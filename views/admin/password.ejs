<h1>Change password</h1>
<% if (typeof error !== 'undefined' && error) { %><p class="adm-err"><%= error %></p><% } %>
<% if (typeof changed !== 'undefined' && changed) { %><p class="adm-ok">Password changed ✓</p><% } %>
<form class="card adm-form narrow-form" method="post" action="/admin/password">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Current password<input type="password" name="old" required></label>
  <label>New password (min 8 chars)<input type="password" name="newp" required minlength="8"></label>
  <button class="btn-adm primary">Change</button>
</form>
